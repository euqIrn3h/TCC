<TelaPrincipal>:
    orientation: "vertical"

    canvas.before:
        Color:
            rgba: 0, 0.05, 0.2, 1
        Rectangle:
            pos: self.pos
            size: self.size

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        BoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height
            padding: 20
            spacing: 12

            Label:
                text: "Algoritmo Genético para Circuitos Lógicos"
                font_size: 24
                bold: True
                color: 1, 1, 1, 1
                size_hint_y: None
                height: "40dp"

            GridLayout:
                cols: 1
                size_hint_y: None
                height: self.minimum_height
                row_default_height: "40dp"
                spacing: 10

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: "40dp"
                    
                    Label:
                        text: "Número de variáveis:"
                        color: 1, 1, 1, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    TextInput:
                        id: input_nvar
                        text: "3"
                        multiline: False
                        input_filter: "int"
                        foreground_color: 1, 1, 1, 1
                        background_color: 0.1, 0.1, 0.2, 1
                        cursor_color: 1, 1, 1, 1
                        disabled: root.executando

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: "40dp"

                    Label:
                        text: "Número de nós:"
                        color: 1, 1, 1, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    TextInput:
                        id: input_nos
                        text: "6"
                        multiline: False
                        input_filter: "int"
                        foreground_color: 1, 1, 1, 1
                        background_color: 0.1, 0.1, 0.2, 1
                        cursor_color: 1, 1, 1, 1
                        disabled: root.executando

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: "40dp"

                    Label:
                        text: "Máx. gerações:"
                        color: 1, 1, 1, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    TextInput:
                        id: input_geracoes
                        text: "50000"
                        multiline: False
                        input_filter: "int"
                        foreground_color: 1, 1, 1, 1
                        background_color: 0.1, 0.1, 0.2, 1
                        cursor_color: 1, 1, 1, 1
                        disabled: root.executando

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: "40dp"

                    Label:
                        text: "Filhos por geração:"
                        color: 1, 1, 1, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    TextInput:
                        id: input_filhos
                        text: "4"
                        multiline: False
                        input_filter: "int"
                        foreground_color: 1, 1, 1, 1
                        background_color: 0.1, 0.1, 0.2, 1
                        cursor_color: 1, 1, 1, 1
                        disabled: root.executando

                GridLayout:
                    cols: 1
                    size_hint_y: None
                    height: self.minimum_height
                    row_default_height: "40dp"

                    Label:
                        text: "Mintermos:"
                        color: 1, 1, 1, 1
                        halign: "left"
                        valign: "middle"
                        text_size: self.size

                    TextInput:
                        id: input_mintermos
                        text: "0,1,3"
                        multiline: False
                        foreground_color: 1, 1, 1, 1
                        background_color: 0.1, 0.1, 0.2, 1
                        cursor_color: 1, 1, 1, 1
                        disabled: root.executando

            Button:
                text: "Executando..." if root.executando else "Executar algoritmo"
                size_hint_y: None
                height: "50dp"
                font_size: 18
                bold: True
                background_normal: ""
                background_color: (0.4, 0.4, 0.4, 1) if root.executando else (0.1, 0.4, 0.8, 1)
                color: 1, 1, 1, 1
                disabled: root.executando
                on_press: root.executar()

<ResultadoPopup>:
    orientation: "vertical"
    padding: "20dp"
    spacing: "15dp"

    canvas.before:
        Color:
            rgba: 0, 0.05, 0.2, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: "Execução do Algoritmo"
        font_size: "22sp"
        bold: True
        color: 1, 1, 1, 1
        size_hint_y: None
        height: "40dp"

    ProgressBar:
        max: 100
        value: root.progresso
        size_hint_y: None
        height: "20dp"

    Label:
        text: root.progresso_texto
        font_size: "16sp"
        color: 1, 1, 1, 1
        size_hint_y: None
        height: "30dp"

    ScrollView:
        do_scroll_x: False
        do_scroll_y: True

        Label:
            text: root.resultado
            text_size: self.width - 20, None
            size_hint_y: None
            height: max(self.texture_size[1] + 20, self.parent.height)
            font_size: "18sp"
            color: 1, 1, 1, 1
            valign: "top"
            halign: "left"
            padding: "10dp", "10dp"

    Button:
        text: "Fechar"
        size_hint_y: None
        height: "45dp"
        disabled: root.executando
        opacity: 0 if root.executando else 1
        on_release: root.fechar()